# Copy to .env and fill in real values locally - .env is gitignored.

# SQLite for local dev, e.g. "file:./dev.db"
DATABASE_URL=

# Random secret for NextAuth session encryption - generate with `openssl rand -base64 32`
AUTH_SECRET=

# Powers the "Ask HOPE" AI assistant. Get a key at https://console.anthropic.com/
# Leave empty to disable the assistant (it fails gracefully, doesn't crash the app).
ANTHROPIC_API_KEY=
