generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ACCOUNT_OWNER
  OWNER
  RENTER
  PROPERTY_MANAGER
  CONTRACTOR
  BOARD_MEMBER
  UNIT_MANAGER
}

// Fixed taxonomy of vendor/service types a Contractor account can be
// classified under - specific companies (contractor accounts) are added
// under a type, rather than each HOA inventing its own free-text list.
enum ContractorCategory {
  ELECTRICITY
  WATER
  GARBAGE
  POOL_MAINTENANCE
  LAWYER
  ACCOUNTANT
  PROPERTY_MANAGEMENT
  INTERNET
  TELEPHONE
  INSURANCE
  HVAC
  PLUMBING
  WINDOWS_DOORS
  OTHER
}

enum RentalPolicy {
  ANYONE
  FRIENDS_FAMILY_ONLY
  SHORT_TERM_RENTAL // STR carries different HOA obligations than a long-term lease
  NOT_RENTING
}

enum UnitStatus {
  OWNER_OCCUPIED
  RENTED
  AVAILABLE
  UNAVAILABLE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  EMERGENCY
}

enum TicketScope {
  UNIT
  COMMON_AREA
}

enum DocumentCategory {
  MEETING_MINUTES
  BYLAWS
  INSURANCE
  RESOLUTION
  CONTRACT
  FINANCIAL
  POLICY
  OTHER
}

// Default OWNERS - everything already in the repository stays visible to
// Owners exactly as before. BOARD_AND_PM hides a document from the Owner
// Governance page entirely (e.g. a vendor contract with sensitive terms),
// while Board members and the Property Manager still see it.
enum DocumentVisibility {
  OWNERS
  BOARD_AND_PM
}

enum Currency {
  USD
  MXN
}

enum OrgDeletionStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
}

// Business-continuity guardrail: a platform admin can request an org's
// deletion, but it only actually executes once BOTH the Account Owner and
// at least one Board Member have approved - protects an org from being
// deleted unilaterally. Deliberately has NO Prisma relations to
// Organization or User - this is an audit record that must remain readable
// after the very org (and possibly people) it concerns are gone, so every
// "who"/"which org" field is a plain id with a name/email snapshot taken
// at the time, not a foreign key that would cascade-delete or dangle.
model OrgDeletionRequest {
  id      String @id @default(cuid())
  orgId   String
  orgName String
  orgSlug String

  status OrgDeletionStatus @default(PENDING)

  requestedById    String
  requestedByEmail String
  requestedAt      DateTime @default(now())
  reason           String?

  accountOwnerApprovedById    String?
  accountOwnerApprovedByName  String?
  accountOwnerApprovedByEmail String?
  accountOwnerApprovedAt      DateTime?

  boardMemberApprovedById    String?
  boardMemberApprovedByName  String?
  boardMemberApprovedByEmail String?
  boardMemberApprovedAt      DateTime?

  deniedById    String?
  deniedByName  String?
  deniedByEmail String?
  deniedAt      DateTime?
  denialReason  String?

  // Full JSON export of the org (see getFullOrgDataExport), generated and
  // saved the moment both approvals are in, right before the org is
  // actually deleted - the whole point of the rule is that nothing is lost.
  backupFileUrl String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
}

enum BoardApprovalStatus {
  NOT_YET_DECIDED
  BOARD_APPROVED
}

// Whether HOPE itself has verified that (a) this organization actually
// exists and (b) the people running the workspace are authorized to
// represent it - distinct from boardApprovalStatus above, which is just
// the org's own self-attestation. Every org starts PROVISIONAL (low
// friction, self-serve) and only becomes VERIFIED after a platform admin
// reviews an OrgVerificationRequest - see approveOrgVerification, which is
// also where the "no single permanent owner" rule is enforced (a verified
// org must already have at least two ACCOUNT_OWNER custodians).
enum OrgVerificationStatus {
  PROVISIONAL
  VERIFIED
}

enum OrgVerificationRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// An Account Owner's application to move their org from PROVISIONAL to
// VERIFIED. Evidence fields are deliberately free text and reviewed by a
// human platform admin rather than auto-validated - what counts as
// sufficient proof of institutional authority varies too much by
// organization type and jurisdiction to encode as rigid fields. Unlike
// OrgDeletionRequest, this has a real relation to Organization since
// approving/denying a request never destroys the org it concerns.
model OrgVerificationRequest {
  id     String                        @id @default(cuid())
  orgId  String
  status OrgVerificationRequestStatus @default(PENDING)

  requestedById    String
  requestedByName  String
  requestedByEmail String
  requestedAt      DateTime @default(now())

  legalEntityName    String?
  registrationNumber String?
  evidenceNotes      String?
  evidenceFileUrl    String?

  reviewedById    String?
  reviewedByName  String?
  reviewedByEmail String?
  reviewedAt      DateTime?
  reviewNotes     String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum PMReferralStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

// Growth lever: a Property Manager already active in one org often runs
// several HOAs/communities elsewhere. This captures a lead on those other
// properties for the platform admin to follow up on and onboard - not a
// technical link to any existing org (the referred property usually isn't
// in HOPE yet). No relation to Organization/User, same reasoning as
// OrgDeletionRequest: a lead should stay visible even if the referring
// membership or org later changes.
model PMReferral {
  id    String @id @default(cuid())
  orgId String
  orgName String

  referredById    String
  referredByName  String
  referredByEmail String

  propertyName   String
  estimatedUnits Int?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?

  status PMReferralStatus @default(NEW)

  // Set once a platform admin actually creates the org from this lead.
  convertedOrgId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  onboardingComplete Boolean   @default(false)
  // Set by a platform admin to lock every member (including the Account
  // Owner) out of the dashboard without touching any data - reversible,
  // unlike deleting the org outright. Null means active.
  suspendedAt        DateTime?

  // Property address, shown on the public property home page
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // The property's formal legal/corporate name, if known - purely a
  // reference field. Whoever enters it (an owner, a PM, anyone) may not
  // have any authority to speak for the HOA, so this is never treated as
  // proof the entity has adopted HOPE - see boardApprovalStatus below.
  legalEntityName String?

  // Whether the HOA's Board has actually decided to use HOPE, as distinct
  // from someone (often a Property Manager, sometimes a lone owner)
  // setting up an account informally to try it out or manage their own
  // piece of it. Defaults to NOT_YET_DECIDED - never assume approval that
  // wasn't explicitly given, so no org is misrepresented as HOPE's
  // official platform for that HOA until a human says so.
  boardApprovalStatus BoardApprovalStatus @default(NOT_YET_DECIDED)

  // See OrgVerificationStatus doc comment - PROVISIONAL until a platform
  // admin approves an OrgVerificationRequest. verifiedBy* is free text,
  // same convention as accountOwnerName/bankContactName below, not a User
  // relation (the reviewing admin's own membership is out of scope here).
  verificationStatus   OrgVerificationStatus @default(PROVISIONAL)
  verifiedAt           DateTime?
  verifiedByName       String?
  verifiedByEmail      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Board-approved reserve savings goal (e.g. $100,000) - the running
  // balance itself is never stored here, it's always computed live from
  // ReserveTransaction so it can never drift into a stale "as of April 30"
  // manual snapshot, which was the exact failure this is meant to fix.
  reserveTarget Float?
  reservePolicy String? // funding/use policy in the Board's own words, e.g. when withdrawals are allowed
  reserveHeldAt String? // institution/account the reserve is actually held at, e.g. "Bank of America - Reserve Acct #1234"

  // Editable inputs for the Reserve Fund Policy summary shown on the reserve
  // page. Board members / the PM adjust these (AGM motions change the target,
  // the horizon, the roof number). Anything null falls back to the frozen
  // defaults in src/lib/reserve-policy-summary.ts; coverage, the floor, the
  // shortfall and the budget top-up are always derived, never stored.
  reservePolicyRevision      String? // e.g. "2", "2.1", "3"
  reservePolicyStatus        String? // e.g. "Adopted at 2027 AGM"
  reservePolicyAsOf          String? // e.g. "start of 2026"
  reservePolicyBalance       Float? // current reserve balance the policy is worked from
  reservePolicyTopUpYears    Int? // years to return the fund to target
  reservePolicyFloorPct      Int? // minimum reserve floor as % of target (special-assessment trigger)
  reservePolicyExchangeRate  Float? // MXN per 1 USD used for the policy's peso figures
  reservePolicyRoofYear      Int?
  reservePolicyRoofDrawdown  Float?
  reservePolicyBudgetYear    Int? // the coming budget year the top-up lands in
  reservePolicyBudgetLineUsd Float? // override for the top-up line (e.g. an AGM-voted round number)

  // Bank Information - part of the Governance "Key Information" tab. Wire/
  // e-transfer receiving details are ordinary business info HOAs already
  // hand out to paying owners (same as any invoice), so this is deliberately
  // free text rather than a rigid account-number field - the Board controls
  // exactly what's shared.
  bankName                String?
  bankAddress             String? // branch address, for wires/in-person visits
  bankPhone               String?
  bankAccountName         String? // e.g. "Sunrise Heights HOA Operating Account"
  bankSigningAuthority    String? // who is authorized to sign/approve on the account
  bankPaymentInstructions String? // how to pay dues / send funds - e-transfer, wire, etc.

  // The bank's own relationship manager/rep for this account - distinct
  // from bankSigningAuthority, which is who on the HOA side can sign.
  bankContactName  String?
  bankContactPhone String?
  bankContactEmail String?

  // The currency all budget/actual figures are entered in. The other
  // currency (USD<->MXN, a fixed pair) is always a derived, computed
  // display using currentExchangeRate - never a second source of truth.
  // No external FX API - manually maintained by the Board/PM.
  baseCurrency          Currency  @default(USD)
  currentExchangeRate   Float? // MXN per 1 USD, by convention
  exchangeRateUpdatedAt DateTime?

  // Declarative statements only - never enforced. An owner's own
  // per-unit visibility/pool-membership choice always wins, even in
  // conflict with what's stated here; that's a matter for the HOA and
  // the owner to work out outside the system, not something HOPE gates.
  occupancyVisibilityPolicy String?
  rentalPoolGuidelines      String?

  // What to call a unit throughout the app - "Villa", "Apt", "Condo", etc.
  // Free text, defaults to the generic "Unit" so existing orgs see no change.
  unitLabel String @default("Unit")

  // Platform admin's billing/account record - independent of whether the
  // invited Account Owner has accepted their invite yet, since admin should
  // be able to record these before any User exists for this org. Free text
  // throughout, same convention as bankName/bankAccountName above.
  accountNumber String?
  pricingPlan   String? // free text, e.g. "$49/mo Standard" - no rigid Plan model yet
  billingExpiry DateTime?
  // How this org pays HOPE - a reference/description (e.g. "Invoice - Net
  // 30", "Card on file via Stripe", "ACH") never actual card/bank numbers -
  // same free-text-reference convention as bankPaymentInstructions below,
  // which is the HOA's own instructions for receiving dues, not this.
  paymentMethod String?

  accountOwnerName         String?
  // Their role/title at the HOA (e.g. "Board President", "self-managed
  // Owner", "hired Property Manager acting as owner") - relevant to
  // business-continuity risk (a sole owner-president is a bigger single
  // point of failure than an owner who is not also on the Board), so it's
  // worth knowing but not required upfront - fine to add later once known.
  accountOwnerTitle        String?
  accountOwnerEmail        String?
  accountOwnerPhone        String?
  accountOwnerAddressLine1 String?
  accountOwnerAddressLine2 String?
  accountOwnerCity         String?
  accountOwnerState        String?
  accountOwnerPostalCode   String?
  accountOwnerCountry      String?

  altContactName  String?
  altContactEmail String?
  altContactPhone String?

  memberships         Membership[]
  units               Unit[]
  invites             Invite[]
  pendingOwners       PendingOwner[]
  ownershipTransferRequests OwnershipTransferRequest[]
  meetings            Meeting[]
  pmContracts         PMContract[]
  pmAccessGrants      PMAccessGrant[]
  documents           Document[]
  contracts           Contract[]
  tickets             TroubleTicket[]
  complianceDocuments ComplianceDocument[]
  boardPositions      BoardPosition[]
  announcements       Announcement[]
  customKeyDates      CustomKeyDate[]
  budgets             Budget[]
  assessments         Assessment[]
  reserveTransactions ReserveTransaction[]
  reserveYearNotes    ReserveYearNote[]
  reserveCapitalItems ReserveCapitalItem[]
  keyDates            KeyDate[]
  keyContacts         KeyContact[]
  employees           Employee[]
  verificationRequests OrgVerificationRequest[]
}

// A User's membership in one Organization, with a role and board-member
// status scoped to that org specifically - the same login can be Account
// Owner of one HOA and a plain Owner of another. This replaced a single
// User.orgId/role/isBoardMember scalar set; session.user.{orgId,role,
// isBoardMember} still exists and represents "the currently active
// membership," just sourced from here instead of directly off User.
model Membership {
  id            String   @id @default(cuid())
  userId        String
  orgId         String
  role          Role
  isBoardMember Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Comma-separated ids of completed onboarding-checklist steps (see
  // src/lib/onboarding-steps.ts) - null/empty means none done yet. Free
  // text rather than a separate table, same convention as
  // User.specialties - the step list is small and defined in code, not
  // user-editable data that needs its own rows.
  onboardingSteps String?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

enum ReserveTransactionType {
  DEPOSIT
  WITHDRAWAL
}

// One free-text comment per org per calendar year - the only genuinely new
// data the reserve-fund year table needs, since opening/additions/drawdowns/
// closing balances are all derived live from ReserveTransaction, same as the
// running balance always has been.
model ReserveYearNote {
  id        String   @id @default(cuid())
  orgId     String
  year      Int
  comment   String
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, year])
}

model ReserveTransaction {
  id          String                 @id @default(cuid())
  orgId       String
  type        ReserveTransactionType
  amount      Float
  date        DateTime
  description String
  createdById String
  createdAt   DateTime               @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
}

// A reserve fund study / capital component schedule - physical items the
// reserve fund exists to eventually pay for (roof, pool pump, paving, etc.),
// distinct from ReserveTransaction (which tracks money actually moving) and
// from Budget/BudgetLineItem (a single fiscal year's line items). This is
// forward-looking across many years and drives "is the fund on track,"
// which condo/HOA audits sometimes specifically require. Estimated
// expenditure date/year is deliberately NOT stored - it's always
// lastDone + lifeExpectancyYears, computed live in src/lib/reserve-fund.ts,
// same "derive, don't duplicate" approach as the year-by-year balance table.
model ReserveCapitalItem {
  id                  String   @id @default(cuid())
  orgId               String
  name                String
  lastDone            DateTime
  lifeExpectancyYears Int
  estimatedCost       Float?
  notes               String?
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
}

// Institutional contacts shown on the Governance "Key Information" tab -
// the PM, lawyer, accountant, insurance company, and employees an Owner
// might otherwise have no idea how to reach. Bank info lives directly on
// Organization instead (see above) since there's exactly one of it per org,
// unlike these, which can repeat per category (e.g. multiple employees).
enum KeyContactCategory {
  PROPERTY_MANAGER
  LAWYER
  ACCOUNTANT
  INSURANCE
  EMPLOYEE
  OTHER
}

model KeyContact {
  id        String             @id @default(cuid())
  orgId     String
  category  KeyContactCategory
  name      String // firm or person name
  role      String? // e.g. "HOA Attorney", "Pool Maintenance Lead"
  phone     String?
  email     String?
  notes     String?
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// One entry per type per org - AGM data gets updated in place year to year
// rather than kept as history, since the "Key Dates" block (see
// src/components/key-info/key-dates-card.tsx) only ever surfaces the
// current/upcoming one. Only AGM lives here - Dues due dates are
// deliberately NOT duplicated into this table, they're derived live from
// Assessment.dueDate (see getUpcomingKeyDates in src/lib/key-dates.ts),
// same "derive, don't duplicate" reasoning as the reserve fund balance.
enum KeyDateType {
  AGM
}

model KeyDate {
  id              String      @id @default(cuid())
  orgId           String
  type            KeyDateType
  date            DateTime
  location        String?
  chairpersonName String?
  agenda          String?
  proxyProcess    String?
  proxyFormUrl    String?
  notes           String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Linked lazily - the first time an AGM is saved (either from the New
  // Meeting dialog with type AGM, or straight from the AGM edit dialog), a
  // companion Meeting row is created and linked here so the AGM page can
  // reuse the existing Meeting/Document (meetingId) and minutes machinery
  // instead of inventing a second attachment mechanism for "AGM documents."
  meetingId String? @unique

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
  meeting   Meeting?     @relation(fields: [meetingId], references: [id])

  @@unique([orgId, type])
}

// Board news/updates shown to Owners on the Governance page - distinct
// from Meetings (formal, scheduled, minutes-bearing) and Documents (files
// on record). Just a dated post: title, body, who posted it.
model Announcement {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  content   String
  authorId  String
  // Audience targeting, added 2026-08-28 - null/empty means visible to
  // everyone (the original, only behavior); otherwise a comma-separated
  // list of Role values, same lightweight-string convention as
  // Membership.onboardingSteps (see src/lib/onboarding-steps.ts) rather
  // than a join table, since this is a small, rarely-multi-valued set.
  // Parse/serialize/check helpers live in src/lib/audience.ts.
  visibleRoles String?
  // Optional self-cleaning expiry, added 2026-08-28 per Dara ("add a
  // remove date or it will clutter") - null means it stays until manually
  // deleted (the original, only behavior). Once past, it's filtered out of
  // every list query (see the shared `notExpired` where-clause helper in
  // src/app/actions/announcements.ts) rather than deleted outright, so it's
  // still recoverable/auditable if ever needed.
  removeAfter DateTime?
  // Optional scheduled publish, added 2026-08-28 per Dara - null means it
  // goes live immediately on creation (the original, only behavior). While
  // in the future, it's excluded from the Owner-facing feed but STILL
  // shown on the poster's own management view (with a "Scheduled" badge)
  // so it can be tracked/edited before it goes live - the opposite
  // treatment from removeAfter, which hides everywhere including the
  // poster's own view once past.
  postOn      DateTime?
  // Soft-delete, added 2026-08-28 per Dara ("all announcements are long
  // term archived") - governance communications need to stay retrievable
  // for record-keeping even once retired, so the trash icon now archives
  // (sets this) instead of a real db.announcement.delete(). null = active.
  // Naturally-expired ones (removeAfter passed) are already never actually
  // deleted either - they just get filtered by date - so both paths land
  // in the same "Archived" section (see the Board/PM announcements pages)
  // rather than needing two different history views.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org      Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author   User                  @relation(fields: [authorId], references: [id])
  comments AnnouncementComment[]
  reads    AnnouncementRead[]
}

// A growing calendar-style list (meetings, payment dates, maintenance,
// inspections, etc.) - deliberately separate from the singleton `KeyDate`
// model above (AGM is "the one current AGM," updated in place; these are
// many independent entries that accumulate and get deleted once past).
// Same audience-targeting convention as Announcement.
model CustomKeyDate {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  date         DateTime
  location     String?
  notes        String?
  visibleRoles String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
}

// Structured Q&A on a specific announcement, replacing the reply-all/
// side-channel email the original review flagged - any org member can ask
// or answer, so the whole thread (and its answer) stays attached to the
// announcement instead of living in one board member's inbox.
model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
}

// One row per (announcement, user) - marks that this user has seen it, so
// Board/PM get a real read count instead of a one-way broadcast with no
// visible record of who's actually seen it.
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

// The board roster - who holds which seat, for how long. Deliberately
// separate from User.isBoardMember: this is descriptive record-keeping
// (title, term dates), not the access gate itself. Ending or removing a
// term does not revoke access - that stays a manual toggle, so nobody
// gets locked out mid-term just because an end date passed before a
// replacement was seated.
model BoardPosition {
  id        String    @id @default(cuid())
  orgId     String
  title     String // e.g. "President", "Treasurer" - HOA-defined, free text
  userId    String? // null = vacant seat
  termStart DateTime
  termEnd   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id])
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  role       Role
  orgId      String
  unitId     String?
  sentById   String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  // Only meaningful when role is RENTER - the arranged lease's terms,
  // captured at invite time so accepting the invite can create the real
  // Lease record immediately rather than leaving a renter with an account
  // but no actual tenancy on file.
  monthlyRent    Float?
  leaseStartDate DateTime?
  leaseEndDate   DateTime?

  // Only meaningful when role is OWNER, from a document-import roster -
  // UnitContact/UnitManagerAssignment are owner-managed records (see
  // requireCurrentOwner in unit-profile.ts), so a custodian importing a
  // roster can't write them directly. Staged here instead, and offered to
  // the real owner as a one-click prompt once they accept - see
  // ImportedContactPrompt. Cleared (all set to null) once applied or
  // dismissed, so the prompt doesn't linger.
  importedOwnerPhone             String?
  importedEmergencyContactName   String?
  importedEmergencyContactPhone  String?
  importedUnitManagerName        String?
  importedUnitManagerCompany     String?
  importedUnitManagerEmail       String?
  importedUnitManagerPhone       String?

  // Set only when this invite exists to carry a buyer's confirmation of a
  // proposed ownership transfer (see OwnershipTransferRequest below) - a
  // plain "join as owner" invite (bulk import, direct invite) leaves this
  // null and keeps today's behavior (accepting it just adds a
  // UnitOwnership row). When set, accepting this invite does NOT create
  // the UnitOwnership immediately - it only records the buyer's
  // confirmation; the actual ownership change waits for every required
  // seller confirmation too (see tryCompleteOwnershipTransfer).
  transferRequestId String? @unique

  org             Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit            Unit?                    @relation(fields: [unitId], references: [id])
  sentBy          User                     @relation("SentInvites", fields: [sentById], references: [id])
  transferRequest OwnershipTransferRequest? @relation(fields: [transferRequestId], references: [id])
}

// A Board-proposed ownership change, added 2026-08-28 per Dara ("no change
// allowed... without verification by Board Member... and confirmation
// acceptance by new owner and selling owner") - replaces the old immediate
// transferUnitOwnership behavior. Nothing in UnitOwnership actually
// changes until every required party has confirmed: every CURRENT owner
// of the unit at proposal time (snapshotted into
// OwnershipTransferSellerConfirmation - a unit can have more than one,
// e.g. a married couple, and Dara's call was that ALL of them must
// confirm, not just one on the unit's behalf) plus the new owner, whose
// confirmation is just accepting the real Invite this creates (reusing
// that existing flow rather than inventing a second one - see
// applyUnitEffects in src/lib/accept-invite.ts).
model OwnershipTransferRequest {
  id            String                 @id @default(cuid())
  orgId         String
  unitId        String
  newOwnerEmail String
  newOwnerName  String
  since         DateTime
  status        TransferRequestStatus  @default(PENDING)
  proposedById  String
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  org                 Organization                          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit                Unit                                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  proposedBy          User                                  @relation(fields: [proposedById], references: [id])
  invite              Invite?
  sellerConfirmations OwnershipTransferSellerConfirmation[]
}

enum TransferRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// One row per current owner who must confirm - snapshotted at proposal
// time so a later, unrelated ownership change elsewhere doesn't retroactively
// add or remove who needs to sign off on THIS request.
model OwnershipTransferSellerConfirmation {
  id            String    @id @default(cuid())
  requestId     String
  ownerId       String
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  request OwnershipTransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  owner   User                     @relation(fields: [ownerId], references: [id])

  @@unique([requestId, ownerId])
}

// A staged owner roster entry - deliberately separate from Invite. Adding
// someone here (by hand, or from a document import) never creates a real
// invite token or grants any access; it's just content the custodian is
// assembling, possibly over several days while showing the roster to
// others, before choosing to actually send anything. "Send" is its own
// explicit action (see sendPendingOwnerInvite/sendAllPendingOwners in
// invites.ts) that converts one of these into a real Invite and deletes
// the row - a PendingOwner and an Invite for the same unit never coexist.
model PendingOwner {
  id                    String   @id @default(cuid())
  orgId                 String
  unitId                String
  name                  String?
  email                 String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  unitManagerName       String?
  unitManagerCompany    String?
  unitManagerEmail      String?
  unitManagerPhone      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([orgId, unitId])
}

// Single-use, expiring token for the "forgot password" flow. A user can have
// multiple outstanding tokens (e.g. requested twice); using any one consumes
// (and invalidates) all of that user's tokens, same reasoning as Invite's
// acceptedAt - a used or expired token must never work again.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String              @id @default(cuid())
  name      String?
  // Nullable as of 2026-08-28, per Dara: "many owners may not have provided
  // emails but can be pending full members" - a real Membership/UnitOwnership
  // can now exist for someone with no email on file at all (shown honestly
  // as "No email on file," never a fabricated placeholder address). Still
  // @unique when present - SQLite (and Postgres) don't enforce uniqueness
  // among NULLs, so any number of no-email users can coexist. A null-email
  // user simply has no way to log in (no address to send an invite/reset
  // to, no credential to match against) until one is added.
  email     String?             @unique
  password  String?
  phone     String?
  company   String?
  category  ContractorCategory? // service type, Contractor role only
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Platform-level operator flag - orthogonal to Role/Membership entirely.
  // A platform admin isn't a member of any particular org; they provision
  // new Organizations (see requirePlatformAdmin). Unrelated to isBoardMember
  // on Membership, which is scoped per-org instead.
  isPlatformAdmin Boolean @default(false)

  // Unit Manager directory profile - lets a registered Unit Manager promote
  // themselves to Owners browsing the directory, instead of being just a
  // bare name/email in a picker.
  headline         String? // short one-line pitch, e.g. "Reliable cleaning & guest turnover, 24/7"
  bio              String?
  specialties      String? // comma-separated UnitManagerArea values
  yearsExperience  Int?
  directoryVisible Boolean @default(true) // opt out to stay assignable but unlisted

  memberships                 Membership[]
  sentInvites                 Invite[]                    @relation("SentInvites")
  ownedUnits                  UnitOwnership[]
  proposedOwnershipTransfers  OwnershipTransferRequest[]
  ownershipTransferSellerConfirmations OwnershipTransferSellerConfirmation[]
  leases                      Lease[]
  assignedTickets             TicketAssignment[]
  contracts                   Contract[]
  submittedTickets            TroubleTicket[]             @relation("SubmittedBy")
  ticketComments              TicketComment[]
  pmMemberships               PMStaffMembership[]
  createdPMCompanies          PropertyManagementCompany[]
  unitManagerAssignments      UnitManagerAssignment[]
  uploadedComplianceDocuments ComplianceDocument[]
  createdOccupancyEntries     OccupancyEntry[]
  createdOccupancyShareLinks  OccupancyShareLink[]
  boardPositions              BoardPosition[]
  announcements               Announcement[]
  createdCustomKeyDates       CustomKeyDate[]
  createdBudgets              Budget[]
  passwordResetTokens         PasswordResetToken[]
  createdAssessments          Assessment[]
  reserveTransactions         ReserveTransaction[]
  reserveCapitalItems         ReserveCapitalItem[]
  keyDates                    KeyDate[]
  announcementComments        AnnouncementComment[]
  announcementReads           AnnouncementRead[]
  recordedRentPayments        RentPayment[]
  createdPMContracts          PMContract[]                @relation("PMContractCreator")
  approvedPMContracts         PMContract[]                @relation("PMContractApprover")
  ownerExpenses               OwnerExpense[]
}

model Unit {
  id                String     @id @default(cuid())
  orgId             String
  number            String
  building          String?
  floor             Int?
  bedrooms          Int?
  bathrooms         Float?
  sqft              Int?
  description       String?
  civicRoll         String? // municipal civic/assessment roll number for this unit
  status            UnitStatus @default(AVAILABLE)
  selfManaged       Boolean    @default(true) // Owner handles the unit themselves, no delegated Unit Manager
  // Handed off to whoever currently needs to get in - the active Renter,
  // a delegated Unit Manager, Board/PM. Deliberately just two free-text
  // fields (not a rotation/expiry system) since a gate or door code is
  // usually a single current value the Owner updates when it changes.
  accessCode        String?
  accessCodeNotes   String? // e.g. "gate code, changes quarterly" or "front door lockbox"
  // This unit's fixed share of common budget/dues, per the governing
  // documents - HOAs rarely split costs evenly across units. Null until
  // the Board/PM sets it; dues can't be estimated for a unit without one.
  allocationPercent Float?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  org                 Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerships          UnitOwnership[]
  ownershipTransferRequests OwnershipTransferRequest[]
  leases              Lease[]
  tickets             TroubleTicket[]
  invites             Invite[]
  pendingOwners       PendingOwner[]
  contacts            UnitContact[]
  managers            UnitManagerAssignment[]
  contracts           Contract[]
  occupancyEntries    OccupancyEntry[]
  occupancyShareLinks OccupancyShareLink[]
  assessmentCharges   AssessmentCharge[]
  ownerExpenses       OwnerExpense[]

  @@unique([orgId, number])
}

// Multiple rows per unit over time - only one should have isCurrent = true
// at once (enforced in the server action, not the DB, matching how
// Lease.isActive already works in this codebase). Past rows are kept for
// forensic/ownership-history purposes rather than being overwritten.
model UnitOwnership {
  id           String       @id @default(cuid())
  unitId       String
  ownerId      String
  rentalPolicy RentalPolicy @default(NOT_RENTING)
  notes        String?
  isCurrent    Boolean      @default(true)
  since        DateTime     @default(now())
  divestedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Occupancy visibility - entirely this owner's call, independent per
  // audience, private/opted-out by default. Never enforced against the
  // org's stated occupancyVisibilityPolicy (see Organization) - and never
  // surfaced to Board/PM as a compliance signal (i.e. don't build a "who
  // opted out" report anywhere, that defeats the point).
  occupancyVisibleToBoard Boolean @default(false)
  occupancyVisibleToPM    Boolean @default(false)
  // Mutual: seeing other pool members' occupancy requires this unit to
  // also be a member. See Organization.rentalPoolGuidelines.
  rentalPoolMember        Boolean @default(false)

  unit  Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Lease {
  id          String    @id @default(cuid())
  unitId      String
  renterId    String
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit     Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  renter   User          @relation(fields: [renterId], references: [id], onDelete: Cascade)
  payments RentPayment[]
}

// A simple rent ledger per lease - lets the Owner (this is their private
// income, not HOA money) see at a glance whether a given period's rent
// actually came in, the same "expected vs. received" pattern Assessments
// already uses for HOA dues, just scoped to one lease instead of every unit.
model RentPayment {
  id            String         @id @default(cuid())
  leaseId       String
  amount        Float
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())

  lease     Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])
}

model TroubleTicket {
  id            String         @id @default(cuid())
  orgId         String
  unitId        String?
  scope         TicketScope    @default(UNIT)
  submittedById String
  title         String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit        Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  submittedBy User               @relation("SubmittedBy", fields: [submittedById], references: [id])
  assignments TicketAssignment[]
  comments    TicketComment[]
}

model TicketAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  contractorId String
  assignedAt   DateTime @default(now())
  notes        String?

  ticket     TroubleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contractor User          @relation(fields: [contractorId], references: [id])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket TroubleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
}

model Document {
  id           String             @id @default(cuid())
  orgId        String
  title        String
  category     DocumentCategory   @default(OTHER)
  visibility   DocumentVisibility @default(OWNERS)
  description  String?
  fileUrl      String?
  content      String?
  uploadedById String
  meetingId    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting Meeting?     @relation(fields: [meetingId], references: [id])
}

// Tags a meeting's nature for the Meetings list and lets "New Meeting"
// route AGM entries into the richer AGM flow (see KeyDate.meetingId above).
// DUES is a plain category tag only - it does NOT feed the Key Dates card's
// derived dues-due-date entries, those still come solely from
// Assessment.dueDate.
enum MeetingType {
  AGM
  DUES
  OTHER
}

model Meeting {
  id        String      @id @default(cuid())
  orgId     String
  title     String
  type      MeetingType @default(OTHER)
  date      DateTime
  location  String?
  agenda    String?
  minutes   String?
  attendees String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents   Document[]
  budgets     Budget[]
  pmContracts PMContract[]
  keyDate     KeyDate?
}

// Property-level contracts (scope PROPERTY, no unitId) are the HOA's own
// vendor agreements - managed by Account Owner/Board, or PM staff holding
// a CONTRACTS access grant on that org. Unit-level contracts (scope UNIT)
// are the current Owner's own arrangements for their unit (e.g. a private
// cleaning service) - Owner retains control, same as UnitContact/
// UnitManagerAssignment. type distinguishes ongoing recurring services
// (utilities, cleaning) from one-off PROJECT work, and flags CRITICAL
// contracts (insurance, government/regulatory) for prominent highlighting
// and expiry tracking, mirroring ComplianceDocument's reminder window.
enum ContractScope {
  PROPERTY
  UNIT
}

enum ContractType {
  RECURRING
  PROJECT
  CRITICAL
}

// Only meaningful when type is RECURRING - the amount is billed per this
// interval (e.g. a monthly landscaping fee) rather than a one-off total.
enum BillingPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Contract {
  id                 String         @id @default(cuid())
  orgId              String
  scope              ContractScope  @default(PROPERTY)
  unitId             String?
  type               ContractType   @default(PROJECT)
  title              String
  contractorId       String
  startDate          DateTime
  endDate            DateTime?
  reminderDaysBefore Int            @default(30)
  amount             Float?
  billingPeriod      BillingPeriod?
  description        String?
  status             String         @default("ACTIVE")
  fileUrl            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contractor      User             @relation(fields: [contractorId], references: [id])
  budgetLineItems BudgetLineItem[]
}

// A private, owner-only manual ledger - distinct from Contract above.
// Contract models a formal vendor agreement (org-visible to Board/PM,
// requires a Contractor account); this is just an owner jotting down
// what they spent, for their own year-end record-keeping. Scoped by
// ownerId directly rather than current UnitOwnership, so the record
// survives a unit sale - only creating a new entry requires currently
// owning the unit (see requireCurrentOwner in owner-expenses.ts).
enum ExpenseCategory {
  RECURRING
  DUES
  MAINTENANCE
  CAPITAL
  CLEANING
  OTHER
}

model OwnerExpense {
  id          String          @id @default(cuid())
  unitId      String
  ownerId     String
  category    ExpenseCategory
  amount      Float
  date        DateTime
  description String
  notes       String?
  createdAt   DateTime        @default(now())

  unit  Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Budget
//
// One Budget per fiscal year, with a free-text version label so the
// Board can keep a Proposed draft, a Revised draft, and the Final
// approved version distinct without a rigid workflow. Only the Final,
// approved version drives Owner-facing figures (dues estimate, the
// read-only Governance view) - drafts stay Board/PM-internal.
// ------------------------------------------------------------

enum BudgetStatus {
  DRAFT
  APPROVED
}

// Operating (the annual recurring budget that funds dues) vs Capital
// (one-off projects - often assessed separately, e.g. a special per-unit
// assessment) - kept as a real category rather than just a version label,
// so they show as genuinely separate lists rather than one flat list the
// reader has to parse by name.
enum BudgetType {
  OPERATING
  CAPITAL
}

model Budget {
  id                   String       @id @default(cuid())
  orgId                String
  year                 Int
  // Optional human period label ("Fiscal 2027", "Jul 2026 - Jun 2027").
  // `year` still anchors dues derivation and the multi-year comparison;
  // this is just what the Board calls the period.
  periodLabel          String?
  // Bumped as a proposed budget goes through changes before approval.
  revision             Int          @default(1)
  version              String       @default("Draft") // e.g. "Proposed", "Revised", "Final"
  // The currency this budget's line-item amounts are stated in, captured
  // when the budget is proposed rather than inherited live from the org.
  currency             Currency     @default(USD)
  // Working pesos-per-USD rate for this budget's converted column. Frozen
  // once APPROVED - approvalExchangeRate below keeps the approval snapshot.
  exchangeRate         Float?
  type                 BudgetType   @default(OPERATING)
  status               BudgetStatus @default(DRAFT)
  approvedAt           DateTime?
  meetingId            String? // the AGM (or other meeting) where it was approved
  // Snapshot of Organization.currentExchangeRate at the moment this budget
  // was approved - frozen forever after, same lifecycle as approvedAt/
  // meetingId (set together in approveBudget, cleared together in
  // revertBudgetToDraft). Null for a still-DRAFT budget or one approved
  // before this feature existed.
  approvalExchangeRate Float?
  notes                String?
  createdById          String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id])
  meeting     Meeting?         @relation(fields: [meetingId], references: [id])
  lineItems   BudgetLineItem[]
  assessments Assessment[]
}

// Optional grouping for budget line items - lets a real HOA budget be
// presented the way it's discussed ("Utilities: $X", "Payroll: $Y")
// without turning the flat list into a chart of accounts. Fixed taxonomy
// + OTHER, same "preset list not free text" approach as ContractorCategory.
enum BudgetCategory {
  UTILITIES
  PAYROLL
  GROUNDS
  MAINTENANCE
  SECURITY
  INSURANCE
  ADMIN
  TAXES_AND_FEES
  RESERVE_CONTRIBUTION
  CAPITAL_EXPENSE
  OTHER
}

model BudgetLineItem {
  id                 String          @id @default(cuid())
  budgetId           String
  label              String
  category           BudgetCategory?
  budgetedAmount     Float
  actualAmount       Float? // filled in at/after year-end for variance
  previousYearActual Float? // manually carried forward - useful reference for Owners
  contractId         String? // pulls in a specific recurring contract's committed amount
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id])
}

// ------------------------------------------------------------
// Assessments & Dues
//
// An Assessment is a real, issued charge to owners - the thing a Budget's
// dues estimate was only ever a preview of. REGULAR_DUES assessments are
// the routine recurring charge (typically drawn from an approved Operating
// budget); SPECIAL assessments are one-off cash calls (e.g. a capital
// project or a shortfall), optionally linked to a Capital budget but not
// required to be. Per-unit shares are snapshotted onto each
// AssessmentCharge at creation time from Unit.allocationPercent, rather
// than computed live, so a later change to a unit's allocation never
// silently rewrites an assessment that's already gone out. A charge stays
// DRAFT-editable (regenerate by deleting and recreating) until issued;
// once ISSUED it's locked and visible to Owners, and only payments can be
// recorded against it from then on - mirrors Budget's draft/approved split.
// ------------------------------------------------------------

enum AssessmentType {
  REGULAR_DUES
  SPECIAL
}

enum AssessmentStatus {
  DRAFT
  ISSUED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  OTHER
}

model Assessment {
  id          String           @id @default(cuid())
  orgId       String
  title       String
  type        AssessmentType   @default(REGULAR_DUES)
  status      AssessmentStatus @default(DRAFT)
  totalAmount Float
  dueDate     DateTime
  budgetId    String?
  notes       String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id])
  budget    Budget?            @relation(fields: [budgetId], references: [id])
  charges   AssessmentCharge[]
}

model AssessmentCharge {
  id            String         @id @default(cuid())
  assessmentId  String
  unitId        String
  amountDue     Float
  amountPaid    Float          @default(0)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Property Manager structure
//
// The PM is a contracted entity (like a supplier) that an HOA
// engages - PMContract is that vendor relationship. A PM can be a
// solo individual (no company/staff below) or a company with
// multiple staff, and a single company can be contracted by more
// than one HOA. Access for a given staff member on a given HOA is
// granular per area (PMAccessGrant) rather than a fixed role tier,
// so span of control can be tailored per person per HOA.
// ------------------------------------------------------------

enum PMEntityType {
  COMPANY
  INDIVIDUAL
}

model PropertyManagementCompany {
  id             String       @id @default(cuid())
  entityType     PMEntityType @default(COMPANY)
  legalName      String
  registrationId String?

  // General company contact (e.g. main office line/inbox)
  email String?
  phone String?

  // Full mailing address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // The specific point-of-contact person, not just a company inbox
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy           User                 @relation(fields: [createdById], references: [id])
  staff               PMStaffMembership[]
  contracts           PMContract[]
  emergencyContacts   PMEmergencyContact[]
  complianceDocuments ComplianceDocument[]
}

model PMEmergencyContact {
  id        String   @id @default(cuid())
  companyId String
  name      String
  role      String?
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  company PropertyManagementCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model PMStaffMembership {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())

  company      PropertyManagementCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessGrants PMAccessGrant[]

  @@unique([companyId, userId])
}

enum PMAccessArea {
  TICKETS
  CONTRACTS
  DOCUMENTS
  STAFF
}

enum PMAccessLevel {
  VIEW
  MANAGE
}

model PMAccessGrant {
  id           String        @id @default(cuid())
  membershipId String
  orgId        String
  area         PMAccessArea
  level        PMAccessLevel @default(VIEW)
  createdAt    DateTime      @default(now())

  membership PMStaffMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([membershipId, orgId, area])
}

enum PMContractStatus {
  ACTIVE
  PENDING
  ENDED
}

model PMContract {
  id        String           @id @default(cuid())
  companyId String
  orgId     String
  status    PMContractStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?

  // Board-approval governance record. responsibilities/terminationTerms
  // are required - a contract can't be sent for Board approval without a
  // defined scope of duties and a defined transfer-of-control/termination
  // clause. terms stays as general free-text notes (fees, etc).
  responsibilities String
  terminationTerms String
  terms            String?
  fileUrl          String?

  createdById  String
  approvedById String?
  approvedAt   DateTime?
  meetingId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    PropertyManagementCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org        Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User                      @relation("PMContractCreator", fields: [createdById], references: [id])
  approvedBy User?                     @relation("PMContractApprover", fields: [approvedById], references: [id])
  meeting    Meeting?                  @relation(fields: [meetingId], references: [id])
}

// ------------------------------------------------------------
// Unit profile
//
// The Owner retains control of their own unit: only the current
// owner may assign contacts and delegate a Unit Manager. A Unit
// Manager is a real HOPE user (e.g. handling guest check-in,
// arranging cleaning, or maintenance/repairs on the owner's behalf),
// with the same span-of-control philosophy as PM staff - granular
// per-area, per-level access grants rather than a fixed role tier.
// ------------------------------------------------------------

enum UnitContactKind {
  PRIME
  EMERGENCY
}

model UnitContact {
  id        String          @id @default(cuid())
  unitId    String
  kind      UnitContactKind
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime        @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model UnitManagerAssignment {
  id        String   @id @default(cuid())
  unitId    String
  userId    String? // null for a manually-entered manager with no HOPE login
  name      String? // manual-entry only - the account's User.name is used otherwise
  phone     String?
  email     String? // manual-entry only - the account's User.email is used otherwise
  notes     String?
  createdAt DateTime @default(now())

  unit   Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants UnitManagerGrant[]

  @@unique([unitId, userId])
}

enum UnitManagerArea {
  GUESTS
  CLEANING
  TICKETS
  OCCUPANCY
}

enum UnitManagerLevel {
  VIEW
  MANAGE
}

model UnitManagerGrant {
  id           String           @id @default(cuid())
  assignmentId String
  area         UnitManagerArea
  level        UnitManagerLevel @default(VIEW)
  createdAt    DateTime         @default(now())

  assignment UnitManagerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, area])
}

// ------------------------------------------------------------
// Occupancy calendar
//
// A chronological log of who is actually staying in a unit and when -
// managed by the current Owner or a delegated Unit Manager holding an
// OCCUPANCY grant. Lives on Unit (not UnitOwnership) so the log persists
// across an ownership change, same reasoning as why Lease is Unit-scoped
// even though it's "current owner's business." An entry's absence means
// "not logged," not "vacant" - don't infer vacancy from calendar gaps;
// VACANT is only ever an explicit entry.
// ------------------------------------------------------------

enum OccupancyType {
  OWNER_FAMILY
  TRUSTED_GUEST
  LONG_TERM_RENTER
  SHORT_TERM_GUEST
  VACANT
}

model OccupancyEntry {
  id              String        @id @default(cuid())
  unitId          String
  startDate       DateTime
  endDate         DateTime
  type            OccupancyType
  occupantName    String?
  occupantContact String?
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  unit      Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
}

// A persistent, revocable, unguessable link an Owner generates for a named
// contact (e.g. a family member) - read-only view of this one unit's
// occupancy, no HOPE account needed. No expiresAt (this is an ongoing
// reference, not a one-time action like Invite) - revokedAt is the kill
// switch instead, so the owner keeps total control over who can see it.
model OccupancyShareLink {
  id          String    @id @default(cuid())
  unitId      String
  token       String    @unique
  label       String // the owner's own reference, e.g. "Mom"
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  unit      Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
}

// ------------------------------------------------------------
// Document repository & compliance
//
// Separate from Contract/PMContract (those are vendor agreements).
// This tracks the HOA's or a PM company's own legal/compliance
// records - entity registration, tax filings, insurance, permits,
// licenses - each with an expiration so nothing lapses unnoticed.
// A record belongs to exactly one owner: an Organization (HOA) or a
// PropertyManagementCompany. HOA records are managed by Account
// Owner/Board always, and by PM staff holding a DOCUMENTS access
// grant on that org. Company records are visible to all of a
// company's staff, managed by the company admin only.
// ------------------------------------------------------------

enum ComplianceDocumentCategory {
  BYLAWS_CONSTITUTION
  RULES_REGULATIONS
  GOVERNING_LAW
  HOMEOWNER_MEETINGS
  ENTITY_REGISTRATION
  TAX_FILING
  INSURANCE
  PERMIT_LICENSE
  OTHER
}

// Sub-part of an annual Homeowner Meetings set (only meaningful when
// category is HOMEOWNER_MEETINGS) - each year typically produces a call
// notice, proxies, an agenda, and minutes, filed as separate records
// sharing the same meetingYear so they can be grouped together.
enum HomeownerMeetingDocType {
  CALL
  PROXIES
  AGENDA
  MINUTES
}

model ComplianceDocument {
  id                 String                     @id @default(cuid())
  orgId              String?
  companyId          String?
  title              String
  category           ComplianceDocumentCategory @default(OTHER)
  description        String?
  fileUrl            String?
  language           String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  reminderDaysBefore Int                        @default(30)

  // Homeowner Meetings only
  meetingYear           Int?
  meetingDocType        HomeownerMeetingDocType?
  minutesFilingRequired Boolean?
  minutesFiled          Boolean?
  minutesFiledAt        DateTime?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company    PropertyManagementCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User                       @relation(fields: [uploadedById], references: [id])
}

// The HOA's own payroll staff (concierge, security, maintenance, building
// manager, gardener). Distinct from KeyContact (external vendors /
// professionals) and from any login Role - an Employee is a record the
// Board keeps, not an account. Visible to every Board member; added or
// removed by a Board Member or the Property Manager only.
// NOTE: government program numbers below are sensitive PII - never
// owner-facing, and a real deployment should treat this table accordingly
// (encryption at rest / access audit), same standing flag as file storage.
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  FORMER
}

// The "government program numbers" pull-down. Mexico-first (IMSS social
// security, CURP population registry, RFC tax id, INFONAVIT housing fund,
// SAR/AFORE retirement, FONACOT credit) with OTHER + a free-text label for
// anything not listed, same "preset list + Other" convention used for
// capital items and contractor categories.
enum EmployeeGovIdType {
  IMSS
  CURP
  RFC
  INFONAVIT
  SAR_AFORE
  FONACOT
  OTHER
}

model Employee {
  id             String         @id @default(cuid())
  orgId          String
  name           String
  employeeNumber String?
  position       String?
  reportsTo      String? // manager's name / "Property Manager" / "Board President" - free text, the manager often isn't another listed employee
  phone          String?
  email          String?
  homeAddress    String? // where they live - kept as one free-form block, same looseness as KeyContact
  hireDate       DateTime?
  endDate        DateTime? // set when they leave; null = still employed
  status         EmployeeStatus @default(ACTIVE)
  notes          String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  govIds EmployeeGovId[]

  @@index([orgId])
}

model EmployeeGovId {
  id         String           @id @default(cuid())
  employeeId String
  type       EmployeeGovIdType
  label      String? // used when type is OTHER
  value      String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
