generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ACCOUNT_OWNER
  OWNER
  RENTER
  PROPERTY_MANAGER
  CONTRACTOR
  BOARD_MEMBER
}

enum RentalPolicy {
  ANYONE
  FRIENDS_FAMILY_ONLY
  NOT_RENTING
}

enum UnitStatus {
  OWNER_OCCUPIED
  RENTED
  AVAILABLE
  UNAVAILABLE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  EMERGENCY
}

enum TicketScope {
  UNIT
  COMMON_AREA
}

enum DocumentCategory {
  MEETING_MINUTES
  CONTRACT
  FINANCIAL
  POLICY
  OTHER
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members   User[]
  units     Unit[]
  invites   Invite[]
  meetings  Meeting[]
  documents Document[]
  contracts Contract[]
  tickets   TroubleTicket[]
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  role       Role
  orgId      String
  unitId     String?
  sentById   String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit   Unit?        @relation(fields: [unitId], references: [id])
  sentBy User         @relation("SentInvites", fields: [sentById], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(OWNER)
  phone     String?
  company   String?
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Organization?      @relation(fields: [orgId], references: [id])
  sentInvites      Invite[]           @relation("SentInvites")
  ownedUnits       UnitOwnership[]
  leases           Lease[]
  assignedTickets  TicketAssignment[]
  contracts        Contract[]
  submittedTickets TroubleTicket[]    @relation("SubmittedBy")
  ticketComments   TicketComment[]
}

model Unit {
  id          String     @id @default(cuid())
  orgId       String
  number      String
  building    String?
  floor       Int?
  bedrooms    Int?
  bathrooms   Float?
  sqft        Int?
  description String?
  status      UnitStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownership UnitOwnership?
  leases    Lease[]
  tickets   TroubleTicket[]
  invites   Invite[]

  @@unique([orgId, number])
}

model UnitOwnership {
  id           String       @id @default(cuid())
  unitId       String       @unique
  ownerId      String
  rentalPolicy RentalPolicy @default(NOT_RENTING)
  notes        String?
  since        DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  unit  Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Lease {
  id          String    @id @default(cuid())
  unitId      String
  renterId    String
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  renter User @relation(fields: [renterId], references: [id], onDelete: Cascade)
}

model TroubleTicket {
  id            String         @id @default(cuid())
  orgId         String
  unitId        String?
  scope         TicketScope    @default(UNIT)
  submittedById String
  title         String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit        Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  submittedBy User               @relation("SubmittedBy", fields: [submittedById], references: [id])
  assignments TicketAssignment[]
  comments    TicketComment[]
}

model TicketAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  contractorId String
  assignedAt   DateTime @default(now())
  notes        String?

  ticket     TroubleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contractor User          @relation(fields: [contractorId], references: [id])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket TroubleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
}

model Document {
  id           String           @id @default(cuid())
  orgId        String
  title        String
  category     DocumentCategory @default(OTHER)
  description  String?
  fileUrl      String?
  content      String?
  uploadedById String
  meetingId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting Meeting?     @relation(fields: [meetingId], references: [id])
}

model Meeting {
  id        String     @id @default(cuid())
  orgId     String
  title     String
  date      DateTime
  location  String?
  agenda    String?
  minutes   String?
  attendees String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Contract {
  id           String    @id @default(cuid())
  orgId        String
  title        String
  contractorId String
  startDate    DateTime
  endDate      DateTime?
  amount       Float?
  description  String?
  status       String    @default("ACTIVE")
  fileUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contractor User         @relation(fields: [contractorId], references: [id])
}
